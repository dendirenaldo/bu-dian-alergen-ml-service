# Build context minimal — jangan salin env/venv/cache ke image.
.git
.gitignore
.env
.env.*
!.env.example
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.idea/
.vscode/
*.log
.DS_Store
