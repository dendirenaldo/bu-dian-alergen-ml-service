BERT_MODEL_NAME=indobenchmark/indobert-base-p1
BERT_MAX_LEN=256
BERT_THRESHOLD=0.5
DEFAULT_MODEL=bilstm
ENSEMBLE_STRATEGY=weighted
ENSEMBLE_WEIGHT_BILSTM=0.4
ENSEMBLE_WEIGHT_BERT=0.6
